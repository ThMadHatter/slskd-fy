# Track Portal Configuration

# slskd REST API credentials
SLSKD_API_URL=http://localhost:5030/api/v0
SLSKD_API_KEY=your_slskd_api_key_here

# Directory Paths inside container
# (These match the volumes mapped in docker-compose.yml)
MUSIC_LIBRARY_PATH=/music
UPLOADS_PATH=/uploads
SINGLES_PATH=/uploads/Singles
DOWNLOADS_PATH=/downloads

# Database connection
DATABASE_URL=sqlite:////config/track_portal.db

# Security & Authentication
SECRET_KEY=supersecretkey_change_me_in_production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpasswordchange_me

# Navidrome connection details
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=admin
NAVIDROME_PASSWORD=navidrome_admin_password
# Alternatively, configure subsonic hex token directly:
NAVIDROME_TOKEN=
NAVIDROME_SALT=

# Optional external integration links (shown in UI buttons)
FILEBROWSER_URL=http://localhost:8080
NAVIDROME_UI_URL=http://localhost:4533

# Download quality rankings (preferred order left to right)
QUALITY_RANKING=flac,alac,wav,aac,mp3_320,mp3_v0
